# Exports — by default ignore generated bulk data, but explicitly keep the
# canonical Stage2 -> Stage3 contract artifacts and the human-readable summary,
# because the existing tracked seed (stage3_seed.json sha256
# 3f68b832d2f29b99d0c96c99179fc92a4c9164d67aaf04de10ebe715329c6073) is referenced
# by Stage3 verification provenance and by tests/test_stage2_current_seed_contract.py.
exports/*.json
exports/*.jsonl
exports/visualizations/*.png
exports/visualizations/*.pdf
!exports/MANIFEST.md
!exports/stage3_seed.json
!exports/evidence_units.json
!exports/s8_evidence_atlas.json
!exports/data_profile.json
!exports/execution_plan.json
!exports/visualization_manifest.json
!exports/run_summary.json
!exports/run_summary.md
