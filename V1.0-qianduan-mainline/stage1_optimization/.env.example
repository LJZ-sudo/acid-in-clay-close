# LLM API config (example). Copy to .env and fill in your real key.
# Default provider: OpenRouter; default model: openai/gpt-5.4.

# OpenRouter config
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY="sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY"
LLM_MODEL="openai/gpt-5.4"

# Optional config
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=240

# Notes:
# - LLM_BASE_URL : OpenRouter OpenAI-compatible endpoint.
# - LLM_API_KEY  : your OpenRouter key (starts with sk-or-...). REQUIRED.
# - LLM_MODEL    : OpenRouter model slug. Use "openai/gpt-5.4".
# - LLM_TEMPERATURE : 0.0 for the deterministic Line-B guardrail (preregistered).
# - LLM_MAX_TOKENS  : gpt-5.4 reasoning consumes tokens; keep >= 4000.
# - LLM_TIMEOUT     : request timeout (s).
#
# Backward compatible: to revert to PoloAPI/DeepSeek, set
#   LLM_BASE_URL="https://poloai.top/v1"; LLM_MODEL="deepseek-v4-pro"
