# 大模型 API 配置示例
# 复制此文件为 .env 并填入真实的配置信息

# PoloAPI 平台配置
LLM_BASE_URL="https://poloai.top/v1"
LLM_API_KEY="sk-replace-with-your-key"
LLM_MODEL="deepseek-v4-pro"

# 可选配置
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=240

# 配置说明：
# - LLM_BASE_URL: PoloAPI 的 API 端点
# - LLM_API_KEY: 你的 PoloAPI 密钥（必需）
# - LLM_MODEL: 模型名称
#     deepseek-v4-pro  : 推荐，推理质量最高，content 干净，reasoning_content 单独通道
#     deepseek-r1-0528 : 同价 R1 新 checkpoint
#     deepseek-r1      : 经典 R1
# - LLM_TEMPERATURE: 温度参数，0.2 较稳定
# - LLM_MAX_TOKENS: 最大输出 token 数（v4-pro 隐藏推理会吃 token，必须 ≥ 3500）
# - LLM_TIMEOUT: 请求超时时间（秒），v4-pro 实测单次 20–40s
