# Stage3 环境变量示例
# 复制此文件为 .env 并填写实际值

# ============================================================
# LLM 端点配置（OpenAI-compatible）
# ============================================================
# 任选一个 provider，填好 KEY 和 BASE_URL，然后用对应的模型命名规范填三档模型。
#
# Option A — OpenRouter (推荐，已用于 publication v2 / 20260607)
#   BASE_URL = https://openrouter.ai/api/v1
#   KEY      = sk-or-v1-...
#   模型名加 provider 前缀，例如 openai/gpt-5.4, openai/gpt-5.2, deepseek/deepseek-v4-pro,
#   anthropic/claude-sonnet-4.6, google/gemini-2.5-flash。
#
# Option B — OpenAI 官方
#   BASE_URL = https://api.openai.com/v1
#   KEY      = sk-...
#   模型名直填，例如 gpt-5.4 / gpt-5.2 / gpt-4o-mini。
#
# Option C — Polo 第三方中转 (历史 / V1 publication 使用，注意账户额度/速率限制)
#   BASE_URL = https://poloai.top/v1
#   KEY      = sk-... (从 polo 仪表板生成)
#   模型名直填（无前缀），并保持 STAGE3_USE_STRUCTURED_OUTPUTS=false。
# ============================================================
STAGE3_API_KEY="replace-with-your-api-key"
STAGE3_API_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# 模型分层（从模型广场复制精确模型名）
# 三档分级路由 (见 src/s8_stage3/config/model_registry.py STEP_TIER_MAP):
#   PREMIUM  => s04_hypothesis / s06_arbiter / s06b_principle (主推理)
#   STANDARD => s07_descriptor (描述符抽取)
#   CHEAP    => s05/s08 literature summaries, paper_card_* (文献摘要)
# 若 STAGE3_MODEL_TIER 留空, 按 STEP_TIER_MAP 分级路由; 否则整体覆盖.
#
# 已验证可用的组合 (OpenRouter, publication v2):
#   CHEAP    = openai/gpt-5.2
#   STANDARD = openai/gpt-5.2
#   PREMIUM  = openai/gpt-5.4
# 历史 (Polo, V1 publication, 已弃):
#   全部 = deepseek-v4-pro
# ============================================================
STAGE3_MODEL_CHEAP=openai/gpt-5.2
STAGE3_MODEL_STANDARD=openai/gpt-5.2
STAGE3_MODEL_PREMIUM=openai/gpt-5.4

# ============================================================
# 运行模式
# ============================================================
STAGE3_RUN_MODE=mock          # mock | real
STAGE3_LLM_MODE=mock          # mock | live
STAGE3_LITERATURE_MODE=mock   # mock | api | manual | hybrid
STAGE3_MODEL_TIER=cheap       # cheap | standard | premium

# ============================================================
# 超时与重试
# ============================================================
STAGE3_TIMEOUT_SECONDS=180
STAGE3_MAX_RETRIES=3
STAGE3_VERIFY_SSL=true

# ============================================================
# 文献 Provider
# ============================================================
STAGE3_OPENALEX_MAILTO=your_email@example.com
STAGE3_SEMANTIC_SCHOLAR_API_KEY=

# ============================================================
# 预算护栏
# ============================================================
STAGE3_MAX_LLM_CALLS_PER_RUN=100
STAGE3_MAX_LITERATURE_QUERIES_PER_STEP=10
STAGE3_MAX_PAPERS_PER_QUERY=20
STAGE3_MAX_TOTAL_PAPERS_PER_STEP=50
STAGE3_ABORT_ON_BUDGET_EXCEEDED=true

# ============================================================
# 采样（低成本 smoke run 用）
# ============================================================
STAGE3_MAX_SAMPLES=0          # 0=不限制
STAGE3_SAMPLE_IDS=            # 逗号分隔，空=全部

# ============================================================
# 缓存与调试
# ============================================================
STAGE3_ENABLE_CACHE=true
STAGE3_CACHE_DIR=              # empty = data/cache/current
STAGE3_NO_CACHE=false
STAGE3_DEBUG_SNAPSHOTS=false
STAGE3_LLM_ENABLE_SMOKE=false
