  "identity": {
    "sample_id": "S60-2-7-1",
    "material_type": "S60",
    "material_description": "S60：磷酸液体对照体系（项目内标注为无黏土载体的酸液基准），用于与黏土限域膜（如 S8）对照；R、N 仍按同一数据字段记录，但物理场景以「液态酸体系」为主，解释时需与限域膜区分。",
    "parameter_definitions": {
      "R": {
        "label_zh": "酸/水摩尔比 R",
        "definition_zh": "n(H3PO4)/n(H2O)，表征酸液中磷酸相对水的摩尔比例，用于描述酸-水组成。",
        "unit": "mol/mol"
      },
      "N": {
        "label_zh": "液/固质量比 N",
        "definition_zh": "液体总质量与黏土（固体载体）质量之比，表征酸在限域孔道/层间中的装载程度。对无黏土对照体系，见对应材料族说明。",
        "unit": "g/g 或无量纲（与实验记录一致）"
      },
      "L_cm": {
        "label_zh": "样品厚度 L",
        "definition_zh": "质子传导方向上的膜/样品厚度，用于由 Rb 换算电导率 σ = L/(Rb·S)。",
        "unit": "cm"
      },
      "S_cm2": {
        "label_zh": "电极面积 S",
        "definition_zh": "与电流方向垂直的有效电极面积，用于 σ 计算及几何归一。",
        "unit": "cm²"
      }
    },
